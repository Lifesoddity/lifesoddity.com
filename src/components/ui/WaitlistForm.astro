---
// The waitlist: one email field. A Netlify Form (Netlify finds it in the built HTML), with a
// honeypot for bots and two hidden fields (which act it is for, where the visitor came from).
// Posted by script so the page stays put; without script it lands on /joined.
import { waitlist } from '../../content/copy/common';

interface Props {
  /** Which drop the sign-up is for. */
  act?: string;
  class?: string;
  button?: string;
}

const { act = 'next-drop', class: cls, button = waitlist.button } = Astro.props;
const id = `email-${act}`;
---

<form
  class:list={['tip', cls]}
  name="waitlist"
  method="POST"
  action="/joined"
  data-netlify="true"
  netlify-honeypot="company"
  data-waitlist
  data-msg-invalid={waitlist.invalid}
  data-msg-empty={waitlist.empty}
  data-msg-failed={waitlist.failed}
  novalidate
>
  <input type="hidden" name="form-name" value="waitlist" />
  <input type="hidden" name="act" value={act} />
  <input type="hidden" name="source" value="" />
  <p class="vh" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
  <div class="tip-row">
    <label class="tip-field" for={id}>
      <span>{waitlist.label}</span>
      <input id={id} type="email" name="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" placeholder={waitlist.placeholder} required />
    </label>
    <button class="tip-go" type="submit">{button}</button>
  </div>
  <p class="tip-err" data-error aria-live="polite"></p>
  <p class="tip-consent">{waitlist.consent}</p>
  <p class="tip-ok sticker" data-ok role="status" hidden>{waitlist.ok}</p>
</form>

<style>
  .tip { position: relative; max-width: 560px; }
  .tip-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 8px; }
  .tip-field span { display: block; margin-bottom: 7px; font: 800 11.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .tip-field input {
    display: block;
    width: 100%;
    height: 56px;
    padding: 0 14px;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--white);
    color: var(--ink);
    font: 600 16px/1 var(--sans);
    -webkit-appearance: none;
    appearance: none;
  }
  .tip-field input::placeholder { color: #666; opacity: 1; }
  .tip-field input:focus-visible { outline: 3px solid var(--pink); outline-offset: 2px; }
  .tip-field input[aria-invalid="true"] { border-color: var(--red); }
  .tip-go { height: 56px; padding: 2px 20px 0; background: var(--red); color: var(--white); font: 400 30px/1 var(--gothic); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
  .tip-go:active { translate: 0 1px; }
  .tip-go:disabled { opacity: .6; cursor: progress; }
  .tip-err { min-height: 1.3em; margin-top: 8px; color: var(--red); font: 700 13.5px/1.3 var(--sans); }
  .tip-consent { font: 600 12px/1.4 var(--sans); color: var(--muted); }
  .tip-ok { position: absolute; z-index: 3; left: 3%; top: 4px; padding: 12px 22px 9px; background: var(--yellow); color: var(--ink); font: 400 44px/1 var(--gothic); text-transform: uppercase; white-space: nowrap; box-shadow: 0 8px 14px rgb(11 11 11 / .3); }
  .tip.is-done .tip-row { opacity: .35; }
  @media (hover: hover) { .tip-go:not(:disabled):hover { background: var(--red-press); } }
</style>
