---
// LIFE'S ODDITY RADIO: an act's soundtrack, in one of two forms.
//
// No Spotify link yet (D1): one coverline strip. The bar, the playlist's name and, when one is
//   known, the track heard on the reel, beside the playlist's cover when it has one. No play
//   button, no sticker about a missing link, no empty box. A name that waits on the owner's OK
//   ("A love letter to Mutsumi") stays small.
// With a link (acts.ts playlist.spotify): the full box. The bar, the name, the cover print (no
//   art at all without one), the PLAY sticker; pressing PLAY sets Spotify's own player (its
//   design, loaded only then) into the white print below (scripts/player.ts).
//
// The box comes back by itself once the link is set: no change here.
import { Image } from 'astro:assets';
import type { Act } from '../../content/acts';
import { knownTrack } from '../../content/acts';
import { player } from '../../content/copy/common';
import { layoutWord } from '../../lib/words';

interface Props {
  act: Act;
  class?: string;
  /** The level of the bar's heading; the box's playlist name sits one level under it. */
  heading?: 2 | 3 | 4;
}

const { act, class: cls, heading = 3 } = Astro.props;
const H = `h${heading}` as 'h2' | 'h3' | 'h4';
const HN = `h${heading + 1}` as 'h3' | 'h4' | 'h5';
const spotify = act.playlist.spotify;
const track = knownTrack.act === act.slug ? knownTrack : null;
const title = act.playlist.name;
// a playlist named after an unconfirmed subtitle ("A love letter to Mutsumi") stays small
const quiet = !act.subtitleConfirmed && act.playlist.name === act.subtitle;
const cover = act.playlist.cover;
const sub = player.sub(act.number, act.title);
// the strip sets the name as large as its column allows, from the word's measured width
const nameW = title ? layoutWord(title).w : 1;
---

{spotify ? (
  <div class:list={['pl-box', 'halftone', !cover && 'no-cover', cls]} data-player data-spotify={spotify} data-name={player.name(title)}>
    <H class="pl-bar">{player.bar}</H>
    <div class="pl-body">
      <div class="pl-info">
        <HN class:list={['pl-title', quiet && 'is-quiet']}>{title}</HN>
        <p class="pl-sub">{sub}</p>
      </div>

      <div class="pl-art">
        {cover && (
          <figure class="ph print pl-cover" data-flash>
            <span class="ph-sh" aria-hidden="true"></span>
            <Image src={cover.image} widths={[400, 640, 800]} sizes="(min-width: 1000px) 28vw, 70vw" alt={cover.alt} />
            <span class="ph-flash" aria-hidden="true"></span>
          </figure>
        )}
        <button class="pl-play sticker" type="button" data-play aria-label={player.playName(player.name(title))}>
          <svg class="pl-play-i" viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5.5v13l10.5-6.5z"></path><path class="i-pause" d="M8.5 5v14M15.5 5v14"></path></svg>
          <span class="pl-play-l" data-play-label>{player.play}</span>
        </button>
      </div>

      <div class="pl-now-box">
        {track && <p class="pl-now"><span class="pl-now-t">{track.title}, {track.artist}</span> <span class="pl-now-c">{player.heardOn(track.heardOn)}</span></p>}
        <p class="pl-state" data-now aria-live="polite"></p>
      </div>

      <div class="pl-slot" data-slot hidden>
        <p class="pl-here" aria-hidden="true">{player.here}</p>
        <div class="ph pl-print">
          <span class="ph-sh" aria-hidden="true"></span>
          <div class="pl-frame"><div class="pl-mount" data-mount></div></div>
          <span class="ph-flash" aria-hidden="true"></span>
          <svg class="mark pl-arrow" viewBox="0 0 70 80" aria-hidden="true"><path d="M60 4C62 40 40 62 12 72M27.7 74.8 12 72 22.3 59.8"></path></svg>
        </div>
        <p class="pl-honest">{player.honest} <a class="pl-open" href={spotify} rel="noopener">{player.open}</a></p>
        <p class="pl-error" data-error hidden>{player.error} <a href={spotify} rel="noopener">{player.open}</a></p>
      </div>
    </div>
  </div>
) : title && (
  <div class:list={['pl-strip', 'halftone', cover && 'has-cover', cls]}>
    <H class="pl-strip-bar">{player.bar}</H>
    <div class="pl-strip-in">
      {cover && (
        <figure class="ph print pl-strip-cover" data-flash>
          <span class="ph-sh" aria-hidden="true"></span>
          <Image src={cover.image} widths={[240, 400, 560]} sizes="(min-width: 1000px) 15vw, (min-width: 700px) 26vw, 36vw" alt={cover.alt} />
          <span class="ph-flash" aria-hidden="true"></span>
        </figure>
      )}
      <div class="pl-strip-text">
        <p class:list={['pl-strip-name', quiet && 'is-quiet']} style={quiet ? undefined : `--w:${nameW}`}>{title}</p>
        {track && (
          <p class="pl-strip-track">
            <span class="pl-strip-t">{player.track(track.title, track.artist)}</span>
            <span class="pl-strip-c">{player.heardOn(track.heardOn)}</span>
          </p>
        )}
      </div>
    </div>
  </div>
)}

<style>
  /* ---------- the coverline strip (no Spotify link yet) ---------- */
  .pl-strip {
    --dot: rgb(11 11 11 / .1);
    --fade: radial-gradient(70% 60% at 100% 0%, #000, transparent 75%);
    --shadow: rgb(11 11 11 / .55);
    position: relative;
    display: grid;
    align-content: start;
    /* a strip keeps its content height in a parent's grid: never a stretched, empty box */
    align-self: start;
    border: 4px solid var(--ink);
    background: var(--yellow);
    color: var(--ink);
  }
  .pl-strip-bar { padding: 9px 14px 5px; background: var(--red); color: var(--white); font: 400 30px/1 var(--gothic); letter-spacing: .06em; text-transform: uppercase; }
  .pl-strip-in { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; column-gap: 16px; padding: 14px 14px 16px; }
  .has-cover .pl-strip-in { grid-template-columns: minmax(0, 40%) minmax(0, 1fr); padding-bottom: 20px; }
  .pl-strip-cover { rotate: -3deg; margin: 4px 0 0 2px; }
  .pl-strip-text { display: grid; gap: 10px; min-width: 0; container-type: inline-size; }
  /* the name fills its column: the column's width over the word's measured width (lib/words.ts) */
  .pl-strip-name { font: 400 56px/.82 var(--gothic); font-size: min(calc(100cqi / var(--w) * .97), 128px); letter-spacing: 0; text-transform: uppercase; white-space: nowrap; }
  .pl-strip-name.is-quiet { font: 800 17px/1.3 var(--sans); white-space: normal; text-transform: none; }
  .pl-strip-track { display: grid; gap: 4px; }
  .pl-strip-t { font: 400 24px/.95 var(--gothic); text-transform: uppercase; }
  .pl-strip-c { font: 600 13px/1.35 var(--sans); }
  @media (min-width: 700px) {
    .pl-strip-bar { padding: 12px 22px 7px; font-size: 40px; }
    .pl-strip-in { padding: 20px 24px 22px; column-gap: 28px; }
    .has-cover .pl-strip-in { grid-template-columns: minmax(150px, 34%) minmax(0, 1fr); padding-bottom: 26px; }
    .pl-strip-text { gap: 14px; }
    /* no cover: the bar and the name share one row, a single coverline strip */
    .pl-strip:not(.has-cover) { grid-template-columns: auto minmax(0, 1fr); }
    .pl-strip:not(.has-cover) .pl-strip-bar { display: flex; align-items: center; }
    .pl-strip:not(.has-cover) .pl-strip-in { padding-block: 14px; }
    .pl-strip-t { font-size: 30px; }
    .pl-strip-c { font-size: 14px; }
    .pl-strip-name.is-quiet { font-size: 19px; }
  }
  @media (min-width: 1000px) {
    .pl-strip-bar { padding: 14px 24px 9px; font-size: min(3.4vw, 48px); }
    .pl-strip-in { padding: 2vw 2.4vw 2.4vw; column-gap: 2.4vw; }
    .has-cover .pl-strip-in { grid-template-columns: minmax(170px, 32%) minmax(0, 1fr); }
    .pl-strip-t { font-size: min(2.4vw, 36px); }
    .pl-strip-c { font-size: max(14px, 1vw); }
  }

  /* ---------- the box (once the Spotify link is in) ---------- */
  .pl-box { --dot: rgb(11 11 11 / .1); --fade: radial-gradient(70% 50% at 100% 0%, #000, transparent 75%); --shadow: rgb(11 11 11 / .55); position: relative; border: 4px solid var(--ink); background: var(--yellow); color: var(--ink); }
  .pl-box :focus-visible { outline-color: var(--ink); }
  .pl-bar { position: relative; padding: 10px 16px 6px; background: var(--red); color: var(--white); font: 400 34px/1 var(--gothic); letter-spacing: .06em; text-transform: uppercase; }
  .pl-body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "info" "art" "now" "slot"; gap: 18px; padding: 18px 14px 22px; }
  .pl-info { grid-area: info; display: grid; gap: 6px; }
  .pl-title { font: 400 min(22vw, 120px)/.8 var(--gothic); text-transform: uppercase; }
  .pl-title.is-quiet { font: 800 17px/1.25 var(--sans); text-transform: none; }
  .pl-sub { font: 700 15px/1.35 var(--sans); }
  .pl-art { grid-area: art; align-self: start; display: grid; grid-template-columns: minmax(0, 1fr); padding-bottom: 12px; }
  .pl-cover { grid-area: 1 / 1; width: 70%; rotate: -3deg; }
  .pl-play {
    grid-area: 1 / 1; justify-self: end; align-self: end; display: grid; place-items: center; align-content: center; gap: 2px;
    width: 116px; height: 116px; margin: 0 3% -14px 0; border-radius: 50%; background: var(--red); color: var(--white);
    box-shadow: inset 0 0 0 4px var(--red), inset 0 0 0 6px var(--white), 0 8px 14px rgb(11 11 11 / .35);
  }
  /* no playlist artwork: no stand-in art, the sticker leads the column */
  .no-cover .pl-art { padding-bottom: 0; }
  .no-cover .pl-play { justify-self: start; margin: 0; }
  .pl-play:active { translate: 0 1px; }
  .pl-play-i { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pl-play .i-pause, :global(.is-playing) .pl-play .i-play { display: none; }
  :global(.is-playing) .pl-play .i-pause { display: inline; }
  .pl-play-l { font: 400 40px/.85 var(--gothic); letter-spacing: .06em; text-transform: uppercase; }
  .pl-now-box { grid-area: now; display: grid; gap: 8px; }
  .pl-now { display: grid; gap: 4px; }
  .pl-now-t { font: 400 34px/.92 var(--gothic); text-transform: uppercase; }
  .pl-now-c { font: 600 13px/1.35 var(--sans); }
  .pl-state { font: 800 12px/1.3 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .pl-state:empty { display: none; }
  .pl-slot { grid-area: slot; display: grid; gap: 10px; }
  .pl-here { justify-self: end; margin-right: calc(12% + 46px); font: 400 30px/1 var(--script); rotate: -4deg; }
  .pl-print { position: relative; display: block; margin-top: 4px; }
  .pl-frame { position: relative; padding: 8px; background: var(--white); }
  .pl-mount { min-height: 152px; border-radius: 12px; background: #282828; }
  .pl-arrow { inset: auto 12% auto auto; top: -62px; width: 70px; height: 80px; }
  .pl-honest, .pl-error { font: 600 13.5px/1.45 var(--sans); }
  .pl-open { font-weight: 800; white-space: nowrap; }
  @media (min-width: 700px) {
    .pl-body { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); grid-template-areas: "art info" "art now" "slot slot"; column-gap: 28px; padding: 24px 24px 28px; }
    .no-cover .pl-body { grid-template-columns: auto minmax(0, 1fr); }
    .pl-info { align-self: end; }
    .pl-now-box { align-self: start; }
    .pl-cover { width: 92%; }
    .pl-title { font-size: min(9vw, 96px); }
  }
  @media (min-width: 1000px) {
    .pl-bar { padding: 14px 24px 9px; font-size: min(3.4vw, 48px); }
    .pl-body { column-gap: 3vw; row-gap: 2vw; padding: 2.4vw; }
    .pl-title { font-size: min(6.2vw, 96px); }
    .pl-play { width: min(9.6vw, 140px); height: min(9.6vw, 140px); margin: 0 -2% -10px 0; }
    .no-cover .pl-play { margin: 0; }
    .pl-play-l { font-size: min(3.1vw, 44px); }
  }
  @media (hover: hover) {
    .pl-play:hover { background: var(--red-press); box-shadow: inset 0 0 0 4px var(--red-press), inset 0 0 0 6px var(--white), 0 8px 14px rgb(11 11 11 / .35); }
  }
</style>
