---
// The inset of the cover story: the act's own campaign shoot as flash-lit prints, its quote in
// his words, and the drop it came from. For She Devil this is THE LOVE LETTER: the letter among
// the rose petals, credited along the print's edge to the photographer his caption names. The
// campaign title stays small until he confirms it may be printed large.
import Print from '../ui/Print.astro';
import type { Act } from '../../content/acts';
import { product as copy } from '../../content/copy/product';

interface Props { act: Act }
const { act } = Astro.props;

const title = copy.inset.titles[act.slug] ?? copy.inset.fallback;
const photos = act.photos.slice(0, 4);
// the full credit from his caption ("Creative directed and shot by @_shaysstudio"), printed once
const creditFor = (credit: string | null) => {
  if (!credit) return null;
  const role = act.credits.find((c) => c.names.some((name) => `@${name}` === credit))?.role;
  return role ? `${role} ${credit}` : credit;
};
const credits = photos.map((p, i) => {
  const c = creditFor(p.credit);
  return c && photos.findIndex((q) => creditFor(q.credit) === c) === i ? c : null;
});
const name = act.number ? copy.actName(act.number, act.title) : act.title;
const small = `${name}. ${act.openedLabel}.${act.subtitle ? ` ${act.subtitle}.` : ''}`;
const tilts = [-3, 2.5, 2, -2.5];
---

{(photos.length > 0 || act.quote) && (
  <section class:list={['lt', 'halftone', photos.length === 0 && 'is-bare', photos.length > 2 && 'is-four']} aria-labelledby="lt-title">
    <div class="lt-copy">
      <h2 class="lt-title" id="lt-title">{title}</h2>
      {act.quote && <blockquote class="lt-quote"><p>{act.quote}</p></blockquote>}
      <p class="lt-drop">{small}</p>
    </div>
    {photos.length > 0 && (
      <div class="lt-prints">
        {photos.map((photo, i) => (
          <Print
            class={`lt-photo lt-${i}`}
            photo={{ kind: 'local', image: photo.image, alt: photo.alt }}
            sizes="(min-width: 1000px) 24vw, (min-width: 700px) 28vw, 44vw"
            ratio={3 / 4}
            tilt={tilts[i % tilts.length]}
          >
            {credits[i] && <figcaption class="lt-credit">{credits[i]}</figcaption>}
          </Print>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .lt {
    --dot: rgb(81 42 52 / .3);
    --fade: radial-gradient(80% 60% at 100% 100%, #000, transparent 75%), radial-gradient(50% 40% at 0% 0%, #000, transparent 70%);
    --shadow: rgb(60 0 18 / .55);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    padding: 44px var(--pad) 64px;
    background: var(--pink);
    color: var(--ink);
    overflow: clip;
  }
  .lt-copy { display: grid; gap: 16px; align-content: start; }
  .lt-title { font: 400 clamp(84px, 25vw, 230px)/.8 var(--gothic); letter-spacing: .005em; text-transform: uppercase; text-wrap: balance; }
  /* white on the hot pink is large type only (3.6:1); the small line stays ink */
  .lt-quote p { max-width: 18ch; color: var(--white); font: 400 40px/.95 var(--gothic); text-transform: uppercase; text-wrap: balance; }
  .lt-quote::before { content: "\201C"; display: block; height: 34px; color: var(--ink); font: 400 110px/.9 var(--gothic); }
  .lt-drop { max-width: 46ch; font: 800 11.5px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; }

  .lt-prints { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 34px; align-items: start; }
  .lt-prints :global(.lt-1) { margin-top: 34px; }
  .lt-prints :global(.lt-3) { margin-top: 34px; }
  /* the real credit, set up the print's right edge */
  .lt-credit {
    position: absolute;
    top: 2%;
    left: calc(100% + 8px);
    max-height: 96%;
    writing-mode: vertical-rl;
    font: 700 10px/1.25 var(--sans);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  @media (min-width: 700px) {
    .lt { grid-template-columns: minmax(0, 1.25fr) minmax(0, 2fr); align-items: start; column-gap: 40px; }
    .lt.is-bare { grid-template-columns: minmax(0, 1fr); }
    .lt-title { font-size: 13vw; }
    .lt-quote p { font-size: 44px; }
    .lt-prints { column-gap: 40px; }
  }
  @media (min-width: 1000px) {
    .lt { grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr); column-gap: 4vw; padding: 5vw var(--pad) 6vw; }
    .lt-title { font-size: min(11vw, 220px); }
    .lt-quote p { font-size: min(3.6vw, 60px); }
    .lt-drop { font-size: 12px; }
    .lt-prints { column-gap: 4vw; row-gap: 3vw; }
    .lt.is-four .lt-prints { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 2.6vw; }
    .lt.is-four { grid-template-columns: minmax(0, 1fr); }
    .is-bare .lt-quote p { max-width: 24ch; font-size: min(6vw, 96px); }
  }
</style>
