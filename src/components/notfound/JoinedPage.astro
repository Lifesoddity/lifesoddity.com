---
// /joined: where a waitlist sign-up lands when JavaScript did not run. The same yellow
// sticker the form slaps on, set giant on black: YOU'RE ON THE LIST. Then the way back, and the
// live piece to look at while the next drop is on its way.
import LivePiece from './LivePiece.astro';
import { getCoverPiece } from '../../lib/pieces';
import { nextDrop } from '../../content/acts';
import { joined as j } from '../../content/copy/notfound';
import { waitlist } from '../../content/copy/common';

const piece = await getCoverPiece();
const deck = nextDrop.name ? j.deckNamed(nextDrop.name, nextDrop.opensLabel) : j.deck;

/** The sticker's two lines, balanced by length, so the paper fits the words. */
function twoLines(text: string) {
  const words = text.split(' ');
  let best = 1;
  let diff = Infinity;
  for (let i = 1; i < words.length; i++) {
    const d = Math.abs(words.slice(0, i).join(' ').length - words.slice(i).join(' ').length);
    if (d < diff) { diff = d; best = i; }
  }
  return words.length > 1 ? [words.slice(0, best).join(' '), words.slice(best).join(' ')] : [text];
}
const title = twoLines(j.title);
---

<section class="jn on-dark halftone" aria-labelledby="jn-title">
  <div class="jn-copy">
    <h1 class="jn-title sticker" id="jn-title" data-slap>{title.map((l, i) => <>{i > 0 && ' '}<span>{l}</span></>)}</h1>
    <p class="jn-deck">{deck}</p>
    <p class="jn-consent">{waitlist.consent}</p>
    <ul class="jn-exits">
      <li><a class="jn-go jn-go-main" href="/"><span>{j.home}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></a></li>
      <li><a class="jn-go" href="/shop"><span>{j.shop}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></a></li>
    </ul>
  </div>
  {piece && <LivePiece class="jn-piece" piece={piece} tape={j.tape} cta={j.see} />}
</section>

<script>
  import { slap } from '../../scripts/motion';
  import { onPage } from '../../scripts/page';

  // the sticker slaps on once, as it does on the form (no overshoot under reduced motion)
  onPage('joined', () => slap(document.querySelector('.jn [data-slap]')));
</script>

<style>
  .jn {
    --dot: rgb(255 46 110 / .24);
    --fade: radial-gradient(65% 50% at 0% 0%, #000, transparent 75%), radial-gradient(60% 50% at 100% 100%, #000, transparent 75%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
    padding: 34px var(--pad) 52px;
    background: var(--ink);
    color: var(--white);
    overflow: clip;
  }
  .jn-copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; justify-items: start; align-content: start; }

  /* the sticker: yellow paper, ink type, stuck on at an angle */
  .jn-title {
    max-width: 100%;
    padding: .12em .2em .04em;
    background: var(--yellow);
    color: var(--ink);
    font: 400 min(25vw, 210px)/.86 var(--gothic);
    text-transform: uppercase;
    box-shadow: 0 10px 18px rgb(0 0 0 / .55);
  }
  .jn-title span { display: block; white-space: nowrap; }
  .jn-deck { max-width: 34ch; margin-top: 10px; font: 700 18px/1.4 var(--sans); }
  .jn-consent { max-width: 40ch; font: 600 13px/1.4 var(--sans); color: rgb(255 255 255 / .78); }

  .jn-exits { display: grid; gap: 10px; width: 100%; margin-top: 4px; }
  .jn-go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 56px;
    padding: 4px 20px 0;
    border: 3px solid var(--white);
    color: var(--white);
    font: 400 30px/1 var(--gothic);
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .jn-go-main { border-color: var(--red); background: var(--red); }
  .jn-go svg { flex: none; width: 24px; height: 24px; margin-top: -4px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: translate var(--fast) ease-out; }
  .jn-go:active { translate: 0 1px; }
  .jn :global(.jn-piece) { color: var(--ink); }
  /* on black, the tag is the red tape, with his script in white */
  .jn :global(.lp-tape) { background: var(--red); color: var(--white); }

  @media (min-width: 700px) {
    .jn { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; column-gap: 4vw; min-height: calc(100svh - var(--header-h)); padding: 5vw var(--pad); }
    .jn-title { font-size: min(12.5vw, 210px); }
  }

  @media (min-width: 1000px) {
    .jn { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); column-gap: 5vw; padding: 3.4vw var(--pad) 4vw; }
    .jn-copy { gap: 1.6vw; }
    .jn-title { font-size: min(11vw, 210px); }
    .jn-deck { margin-top: 1.4vw; font-size: max(18px, 1.5vw); }
    .jn-exits { width: auto; grid-template-columns: repeat(2, max-content); gap: 12px; }
    .jn-go { min-height: 60px; font-size: min(2.6vw, 36px); }
  }

  @media (hover: hover) {
    .jn-go:hover svg { translate: 4px 0; }
    .jn-go:not(.jn-go-main):hover { background: var(--white); color: var(--ink); }
    .jn-go-main:hover { background: var(--red-press); border-color: var(--red-press); }
  }
</style>
