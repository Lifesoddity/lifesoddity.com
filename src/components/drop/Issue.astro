---
// One act, printed as one issue of the magazine: its title with its tags (the act stamp, the vice
// on a tape tag), the issue line (its name, the day it dropped and its state, unless the tape
// already says it), its dictionary entry, its pieces as prints (live ones link to their product
// page and carry their price; archive ones carry a rubber stamp and no price), the issue's other
// campaign photos, its quote, its credits (only in an issue that shows the photos they credit),
// its playlist and, when there is one, its closing line. The ground comes from the act's first
// piece, so every issue keeps the colours of its own material. Everything is read from
// content/acts.ts and the pieces, so a new act is a new issue with no change here.
//
// Which picture prints where (D2, each image has one main place to live):
// - A live piece's own Shopify photo and cut-out live on the cover, the story, the shop and its
//   product page. Its issue prints the act's campaign photos instead (She Devil: the letter on
//   rose petals, then the letter), and any campaign photo left over prints beside the playlist.
//   With no campaign photo, its cut-out or its shot, on a contrasting ground.
// - An archive piece's main photo lives in the home story and the shop archive. Its issue prints
//   the alternate (the hoodie worn open, the Spotlight close-up). A piece shot on its own studio
//   gradient (the jacket) prints as its cut-out, front side, on a contrasting ground (D2, D4).
// - A piece with no picture shows its name and act only: no stand-in box (D1).
import Print from '../ui/Print.astro';
import Player from '../ui/Player.astro';
import type { Act } from '../../content/acts';
import { statusLabel, type Piece } from '../../lib/pieces';
import { formatPrice } from '../../lib/money';
import { drop } from '../../content/copy/drop';
import { status } from '../../content/copy/common';

interface Props {
  act: Act;
  pieces: Piece[];
  /** The issue on sale now: its title is an h2 (the back issues sit under their own h2). */
  live?: boolean;
}

type Photo = NonNullable<Piece['photo']>;
/** What an issue prints for a piece: a photo (a campaign print, or a shot on a ground), or its cut-out. */
type View = { photo: Photo } | { cut: true };

const { act, pieces, live = false } = Astro.props;
const c = drop.issue;
const H = live ? 'h2' : 'h3';
const HP = live ? 'h3' : 'h4';

const lead = pieces[0];
const ground = lead?.art.ground ?? 'var(--yellow)';
const dark = lead?.art.ink === 'white';
const dot = lead?.art.dot ?? 'rgb(11 11 11 / .1)';
// the contrasting ground a cut-out or a shot sits on: yellow, or white on an issue that is yellow
const panel = /ffe500|--yellow/i.test(ground) ? 'var(--white)' : 'var(--yellow)';
const onSale = pieces.some((p) => p.status === 'live');
const state = act.status === 'archive' ? status.archive : onSale ? status.live : status.soldout;
const actLabel = act.number ? c.act(act.number) : null;
// the vice rides the title on a tape tag; an act with no vice gets its state instead
const tape = act.vice ?? (act.status === 'live' ? state : null);
// the issue line says the state only when the tape does not
const issueLine = [c.name(act.title), act.openedLabel ? c.opened(act.openedLabel) : null, tape === state ? null : state]
  .filter(Boolean)
  .join(' · ');

const def = act.definition;
const cut = def ? def.indexOf(':') : -1;
const headword = def && cut > 0 ? def.slice(0, cut) : null;
const meaning = def && cut > 0 ? def.slice(cut + 1).trim() : def;

// the pictures (see the top of this file)
const campaign: Photo[] = act.photos.map((ph) => ({ kind: 'local', image: ph.image, alt: ph.alt }));
const unused = live ? [...campaign] : [];
const views: (View | null)[] = pieces.map((p) => {
  if (p.product) {
    const own = unused.shift();
    if (own) return { photo: own };
    if (p.art.cutout) return { cut: true };
    return p.photo ? { photo: p.photo } : null;
  }
  if (p.art.cutout) return { cut: true };
  const alternate = p.photos[1] ?? p.photos[0];
  return alternate ? { photo: alternate } : null;
});

// the prints: one piece sits beside the playlist; several make a spread of different sizes
const spread = pieces.length > 1;
// the campaign photos no piece took, beside the playlist of a one-piece issue (at most two)
const more = spread ? [] : unused.slice(0, 2);

// the credits name the people behind the campaign photos, so they print only in an issue that
// shows those photos, never as a byline under a Shopify mockup they did not shoot
const shown = [...views.map((v) => (v && 'photo' in v ? v.photo : null)), ...more];
const showsCampaign = shown.some((ph) => ph?.kind === 'local' && act.photos.some((a) => a.image.src === ph.image.src));
const credits = showsCampaign ? act.credits : [];
const hasWords = !!act.quote || credits.length > 0;

const slots: Record<number, { col: string; dy: number; tilt: number }[]> = {
  2: [{ col: '1 / 7', dy: 0, tilt: -3 }, { col: '8 / 13', dy: 7, tilt: 2.5 }],
  3: [{ col: '1 / 5', dy: 0, tilt: -3 }, { col: '5 / 8', dy: 9, tilt: 2.5 }, { col: '8 / 13', dy: 2.5, tilt: -1.5 }],
};
const cycle = [{ col: '1 / 6', dy: 0, tilt: -3 }, { col: '6 / 9', dy: 7, tilt: 2.5 }, { col: '9 / 13', dy: 2, tilt: -1.5 }];
const slotOf = (i: number) => slots[pieces.length]?.[i] ?? cycle[i % cycle.length];
const sizesOf = (i: number) => {
  if (!spread) return '(min-width: 1000px) 38vw, (min-width: 700px) 46vw, 84vw';
  const span = slotOf(i).col.split('/').map(Number);
  return `(min-width: 700px) ${Math.round(((span[1] - span[0]) / 12) * 92)}vw, 84vw`;
};
const ratioOf = (ph: Photo) => {
  const img = ph.image;
  const r = 'width' in img && img.width && img.height ? img.width / img.height : 0.75;
  return Math.min(1, Math.max(0.75, Math.round(r * 1000) / 1000));
};
const altOf = (p: Piece, ph: Photo) => (ph.kind === 'local' ? ph.alt : ph.image.alt || p.art.cutout?.alt || p.title);
const forSaleOf = (p: Piece) => p.status === 'live' && !!p.product;
// a piece on sale leaves its status to the price sticker, which already says OUT NOW
const metaOf = (p: Piece) => {
  const where = `${actLabel ? `${actLabel}: ` : ''}${act.title}`;
  return forSaleOf(p) ? where : `${statusLabel[p.status]}. ${where}`;
};
---

<article
  class:list={['is', 'halftone', spread ? 'is-spread' : 'is-solo', !hasWords && 'is-bare', more.length > 0 && 'has-more', dark && 'on-dark', dark && 'is-dark']}
  id={act.slug}
  aria-labelledby={`${act.slug}-title`}
  style={`--g:${ground};--dot:${dot};--panel:${panel}`}
>
  <header class="is-head">
    <div class="is-tw">
      <H class="is-title" id={`${act.slug}-title`}>{act.title}</H>
      {(actLabel || tape) && (
        <div class="is-tags">
          {actLabel && <p class="stamp is-act">{actLabel}</p>}
          {tape && <p class="tape is-tape">{tape}</p>}
        </div>
      )}
    </div>
    <p class="is-line">{issueLine}</p>
  </header>

  {meaning && <p class="is-def">{headword && <b>{headword}:</b>} {meaning}</p>}

  {pieces.length > 0 && (
    <ul class="is-pieces">
      {pieces.map((p, i) => {
        const slot = slotOf(i);
        const forSale = forSaleOf(p);
        const view = views[i];
        const tilt = spread ? slot.tilt : -3;
        const seal = !forSale && (
          <span class="is-seal" aria-hidden="true">
            <b>{statusLabel[p.status]}</b>
            {actLabel && <span>{actLabel}</span>}
          </span>
        );
        const link = { href: p.href, label: p.href ? c.seeLabel(p.title) : undefined };
        return (
          <li class="is-piece" style={`--col:${slot.col};--dy:${slot.dy}`}>
            {view && (
              <div class="is-pic">
                {'cut' in view ? (
                  <div class="is-ground halftone">
                    <Print cutout={p.art.cutout} side="front" sizes={sizesOf(i)} {...link} tilt={tilt} />
                    {seal}
                  </div>
                ) : view.photo.kind === 'shopify' ? (
                  <div class="is-ground halftone">
                    <Print photo={view.photo} sizes={sizesOf(i)} alt={altOf(p, view.photo)} {...link} ratio={ratioOf(view.photo)} />
                    {seal}
                  </div>
                ) : (
                  <Print photo={view.photo} sizes={sizesOf(i)} alt={altOf(p, view.photo)} {...link} tilt={tilt} ratio={ratioOf(view.photo)}>
                    {seal}
                  </Print>
                )}
                {forSale && (
                  <p class="is-badge" data-live={p.product!.handle}>
                    <b class="num" data-live-price>{formatPrice(p.product!.price)}</b>
                    <span class="is-badge-on">{status.live}</span>
                    <span class="is-badge-off">{status.soldout}</span>
                  </p>
                )}
              </div>
            )}
            <div class="is-cap">
              <HP class="is-ptitle">{p.title}</HP>
              <p class="is-meta">{metaOf(p)}</p>
              {!forSale && p.description && <p class="is-desc">{p.description}</p>}
              {p.href && (
                <a class="is-go" href={p.href}>
                  <span>{c.see}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )}

  {more.length > 0 && (
    <div class="is-more">
      {more.map((ph, i) => (
        <Print
          photo={ph}
          sizes="(min-width: 1000px) 38vw, (min-width: 700px) 46vw, 72vw"
          alt={ph.kind === 'local' ? ph.alt : ''}
          tilt={i % 2 ? -2 : 2.5}
          ratio={ratioOf(ph)}
        />
      ))}
    </div>
  )}

  {hasWords && (
    <div class="is-words">
      {act.quote && <blockquote class="is-quote"><p>{act.quote}</p></blockquote>}
      {credits.length > 0 && (
        <div class="is-cr">
          <HP class="is-cr-h">{c.credits}</HP>
          <dl class="is-credits">
            {credits.map((cr) => (
              <div><dt>{cr.role}</dt> <dd>{cr.names.map((nm) => `@${nm}`).join(', ')}</dd></div>
            ))}
          </dl>
        </div>
      )}
    </div>
  )}

  <div class="is-play">
    <Player act={act} heading={live ? 3 : 4} />
  </div>

  {act.line && <p class="is-end">{act.line}</p>}
</article>

<style>
  .is {
    --lc: var(--ink);
    --qm: var(--white);
    --fade: radial-gradient(70% 45% at 100% 0%, #000, transparent 75%), radial-gradient(60% 40% at 0% 100%, #000, transparent 75%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 22px;
    padding: 30px var(--pad) 48px;
    background: var(--g, var(--yellow));
    color: var(--lc);
    overflow: clip;
    scroll-margin-top: var(--header-h);
  }
  .is-dark { --lc: var(--white); --qm: var(--yellow); }

  /* the head: the title wearing its tags, then the issue line. The tags (the act stamp on the
     left, the tape on the right) ride a row of their own above the title, so the tape never
     crosses its letters at any width (D7). */
  .is-head { display: grid; justify-items: start; gap: 10px; }
  .is-tw { display: grid; }
  .is-title { grid-row: 2; font: 400 clamp(84px, 26vw, 150px)/.8 var(--gothic); letter-spacing: .005em; text-transform: uppercase; text-wrap: balance; }
  .is-tags { grid-row: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-bottom: 18px; }
  .is-act { font-size: 13px; background: var(--white); rotate: -4deg; }
  .is-tape { position: relative; margin: 0 -6px 0 auto; font-size: 32px; white-space: nowrap; rotate: -6deg; }
  .is-line { justify-self: stretch; margin-top: 4px; padding: 6px 0 5px; border-top: 3px solid currentColor; border-bottom: 1px solid currentColor; font: 800 10.5px/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; }

  /* the dictionary entry */
  .is-def { max-width: 40ch; font: 600 17px/1.42 var(--sans); }
  .is-def b { font-weight: 800; font-style: italic; }

  /* the prints */
  .is-pieces { display: grid; gap: 40px; padding: 6px 0 4px; }
  .is-piece { display: grid; gap: 22px; width: 86%; }
  .is-piece:nth-child(even) { justify-self: end; }
  .is-pic { position: relative; }
  .is-pic :global(.ph) { --shadow: rgb(11 11 11 / .55); }
  .is-dark .is-pic :global(.ph) { --shadow: rgb(0 0 0 / .5); }
  .is-pic :global(.ph > img) { width: 100%; }

  /* a cut-out (or a product shot) on its contrasting ground: a square of flat colour pasted into
     the issue with the same hard, slightly blurred shadow as the prints */
  .is-ground {
    --dot: rgb(11 11 11 / .12);
    --fade: radial-gradient(80% 70% at 30% 20%, #000, transparent 78%);
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--panel, var(--yellow));
    box-shadow: 10px 12px 5px rgb(11 11 11 / .45);
  }
  .is-ground :global(.cut) { width: 62%; }
  .is-ground :global(.shot) { width: 84%; }

  /* the archive stamp, pressed on the print's corner in the issue's own colours */
  .is-seal {
    position: absolute;
    z-index: 3;
    right: -12px;
    bottom: -14px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 3px;
    width: 96px;
    height: 96px;
    border: 2px solid currentColor;
    border-radius: 50%;
    background: var(--g, var(--red));
    color: var(--lc);
    rotate: -10deg;
    box-shadow: 0 6px 12px rgb(0 0 0 / .3);
  }
  .is-seal::before { content: ""; position: absolute; inset: 5px; border: 1.5px solid currentColor; border-radius: 50%; }
  .is-seal b { font: 400 27px/.85 var(--gothic); letter-spacing: .04em; text-transform: uppercase; }
  .is-seal span { font: 800 9.5px/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; }

  /* the price sticker on a piece that is on sale */
  .is-badge {
    position: absolute;
    z-index: 3;
    right: -10px;
    top: -16px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 3px;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    rotate: 8deg;
    box-shadow: inset 0 0 0 4px var(--yellow), inset 0 0 0 6px var(--ink), 0 8px 14px rgb(60 0 18 / .4);
    pointer-events: none;
  }
  .is-badge b { font: 400 46px/.8 var(--gothic); }
  .is-badge span { font: 800 10.5px/1.1 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .is-badge-off, .is-badge[data-soldout] .is-badge-on { display: none; }
  .is-badge[data-soldout] .is-badge-off { display: inline; }

  /* the caption under each print */
  .is-cap { display: grid; gap: 5px; justify-items: start; }
  .is-ptitle { font: 400 40px/.88 var(--gothic); text-transform: uppercase; }
  .is-meta { font: 800 10.5px/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .is-desc { max-width: 38ch; margin-top: 3px; font: 500 14px/1.42 var(--sans); }
  .is-go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    margin-top: 8px;
    padding: 2px 16px 0;
    background: var(--ink);
    color: var(--white);
    font: 400 26px/1 var(--gothic);
    letter-spacing: .05em;
    text-transform: uppercase;
    text-decoration: none;
    rotate: -1.5deg;
  }
  .is-dark .is-go { background: var(--white); color: var(--ink); }
  .is-go svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: translate var(--base) var(--ease-out); }
  .is-go:active { translate: 0 1px; }

  /* the issue's other campaign photos, dropped in at the other side */
  .is-more { display: grid; gap: 32px; justify-items: end; padding: 4px 6px 10px 0; }
  .is-more :global(.ph) { --shadow: rgb(11 11 11 / .55); width: 72%; }
  .is-more :global(.ph > img) { width: 100%; }

  /* the quote and the credits */
  .is-words { display: grid; gap: 22px; align-content: start; }
  .is-quote p { font: 400 44px/.92 var(--gothic); text-transform: uppercase; text-wrap: balance; }
  .is-quote::before { content: "\201C"; display: block; height: .36em; color: var(--qm); font: 400 112px/.9 var(--gothic); }
  .is-cr { display: grid; gap: 8px; padding-top: 10px; border-top: 1px solid currentColor; }
  .is-cr-h { font: 800 11.5px/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .is-credits { display: grid; gap: 5px; }
  .is-credits dt { display: inline; font: 800 10.5px/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .is-credits dd { display: inline; font: 600 13px/1.4 var(--sans); overflow-wrap: anywhere; }

  /* the playlist: the strip keeps its own height (Player.astro) */
  .is-play { min-width: 0; }

  /* the closing line, on a black strip across the bottom of the issue */
  .is-end {
    margin: 18px calc(-1 * var(--pad)) -48px;
    padding: 16px var(--pad) 14px;
    background: var(--ink);
    color: var(--yellow);
    font: 400 12.5vw/.86 var(--gothic);
    text-transform: uppercase;
  }

  @media (min-width: 700px) {
    .is { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-areas: none; column-gap: 20px; row-gap: 30px; padding: 44px var(--pad) 60px; }
    .is-head { grid-column: 1 / -1; }
    .is-title { font-size: 16vw; }
    .is-tape { margin-right: -14px; font-size: 40px; }
    .is-line { font-size: 11px; }
    .is-def { grid-column: 1 / 10; font-size: 19px; }
    .is-pieces { grid-column: 1 / -1; }
    .is-words, .is-play, .is-more { grid-column: 1 / -1; }
    .is-end { grid-column: 1 / -1; margin-bottom: -60px; font-size: 10vw; }

    /* one piece: the print beside the quote, the playlist under both */
    .is-solo .is-pieces { grid-column: 1 / 7; }
    .is-solo .is-piece { width: 100%; }
    .is-solo .is-words { grid-column: 7 / -1; align-self: center; }
    /* one piece and no quote or credits under it: the dictionary entry moves up beside the print,
       so the half beside it is never left empty */
    .is-bare .is-pieces { grid-row: 2; }
    .is-bare .is-def { grid-column: 7 / -1; grid-row: 2; align-self: center; }
    /* one piece and more campaign photos: they drop in beside the print, the credits under them */
    .has-more .is-pieces { grid-row: 3 / span 2; }
    .has-more .is-more { grid-column: 7 / -1; grid-row: 3; align-self: start; justify-items: stretch; padding: 7vw 8px 0 4px; }
    .has-more .is-more :global(.ph) { width: 100%; }
    .has-more .is-words { grid-column: 7 / -1; grid-row: 4; align-self: start; }
    .has-more .is-play { grid-row: 5; }

    /* several pieces: a spread of different sizes, dropped at different heights */
    .is-spread .is-pieces { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 20px; row-gap: 48px; align-items: start; }
    .is-spread .is-piece { grid-column: var(--col); width: 100%; margin-top: calc(var(--dy) * 1vw); }
    .is-spread .is-piece:nth-child(even) { justify-self: stretch; }
    .is-spread .is-ptitle { font-size: clamp(28px, 3.2vw, 44px); }
    .is-seal { width: clamp(84px, 8vw, 112px); height: clamp(84px, 8vw, 112px); }
    .is-seal b { font-size: clamp(24px, 2.2vw, 31px); }
  }

  @media (min-width: 1000px) {
    .is { column-gap: 24px; row-gap: 2.8vw; padding: 3.6vw var(--pad) 4.4vw; }
    .is-head { grid-column: 1 / 9; grid-row: 1; align-self: end; }
    .is-title { font-size: 12vw; }
    .is-tags { margin-bottom: 1.4vw; }
    .is-tape { margin-right: -2.4vw; font-size: max(40px, 3.2vw); }
    .is-line { font-size: 12px; }
    .is-def { grid-column: 9 / 13; grid-row: 1; align-self: end; margin-bottom: 4px; font-size: max(18px, 1.45vw); }
    .is-quote p { font-size: max(44px, 3.6vw); }
    .is-quote::before { font-size: max(112px, 8vw); }
    .is-end { grid-row: 4; margin-bottom: -4.4vw; padding: 1.6vw var(--pad) 1.3vw; font-size: 8vw; }

    .is-solo .is-pieces { grid-column: 1 / 6; grid-row: 2 / 4; align-self: start; padding-top: 1vw; }
    .is-solo .is-play { grid-column: 6 / 13; grid-row: 2; }
    .is-solo .is-words { grid-column: 6 / 13; grid-row: 3; align-self: start; }
    .is-badge { right: -1.6vw; top: -1.8vw; width: max(104px, 9.4vw); height: max(104px, 9.4vw); }
    /* one piece: the playlist starts level with the print's top, so the sticker stays on the
       print's corner instead of hanging into the gap (D7) */
    .is-solo .is-badge { right: .4vw; }
    .is-badge b { font-size: max(46px, 4.2vw); }
    .is-badge span { font-size: max(10.5px, .82vw); }
    .is-solo .is-ptitle { font-size: max(40px, 3.6vw); }
    /* no quote or credits: the entry goes back beside the title; the playlist keeps its own
       height beside the print, centred on it, never stretched into an empty box (r2-4) */
    .is-bare .is-def { grid-column: 9 / 13; grid-row: 1; align-self: end; }
    .is-bare .is-pieces { grid-row: 2; }
    .is-bare .is-play { grid-row: 2; align-self: center; }
    .is-bare .is-end { grid-row: 3; }
    /* more campaign photos: the playlist strip across the top of the right side, the second
       photo under it and the credits beside that photo, so the side of the print is full */
    .has-more .is-pieces { grid-row: 2 / 4; }
    .has-more .is-play { grid-column: 6 / 13; grid-row: 2; }
    .has-more .is-more { grid-column: 6 / 11; grid-row: 3; padding: .6vw 1vw 0 1.6vw; }
    .has-more .is-words { grid-column: 11 / 13; grid-row: 3; align-self: end; }

    .is-spread .is-pieces { grid-column: 1 / 13; grid-row: 2; column-gap: 24px; padding-bottom: 1vw; }
    .is-spread .is-words { grid-column: 1 / 6; grid-row: 3; }
    .is-spread .is-play { grid-column: 6 / 13; grid-row: 3; }
  }

  @media (hover: hover) {
    .is-go:hover svg { translate: 4px 0; }
  }
</style>
