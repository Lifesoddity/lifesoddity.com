---
// A print opened large, in place: a native <dialog> over the spread. Escape or the close button
// closes it; the arrows, the arrow keys or a swipe move through the act's photos. The photo is
// shown, never offered as a download (downloads fail inside Instagram's and TikTok's browsers).
// A cut-out opens as it lies on the sheet: on its yellow ground, with its own silhouette shadow.
import { lookbook as copy } from '../../content/copy/lookbook';

const v = copy.viewer;
---

<dialog class="lb-box on-dark" aria-label={v.label} data-viewer>
  <div class="lb-box-bar">
    <p class="lb-box-title"><span data-v-act></span> <span class="lb-box-count num" data-v-count></span></p>
    <button class="lb-box-btn" type="button" data-v-close aria-label={v.close} autofocus>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <div class="lb-box-stage" data-v-stage>
    <figure class="lb-box-print ph" data-v-print>
      <span class="ph-sh" aria-hidden="true"></span>
      <span class="lb-box-paper" data-v-paper>
        <span class="lb-box-pic" data-v-pic><span class="lb-box-cutsh" aria-hidden="true"></span></span>
        <span class="lb-box-credit" data-v-credit hidden></span>
      </span>
      <span class="ph-flash" aria-hidden="true"></span>
      <figcaption class="lb-box-cap" data-v-cap hidden></figcaption>
    </figure>
  </div>
  <div class="lb-box-nav">
    <button class="lb-box-btn lb-box-prev" type="button" data-v-prev aria-label={v.prev}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <a class="lb-box-piece" data-v-piece hidden></a>
    <button class="lb-box-btn lb-box-next" type="button" data-v-next aria-label={v.next}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
  <p class="vh" aria-live="polite" data-v-say></p>
</dialog>

<script>
  import { flash, reduceMotion } from '../../scripts/motion';
  import { lookbook as copy } from '../../content/copy/lookbook';

  import { onPage } from '../../scripts/page';

  onPage('viewer', () => {
    const box = document.querySelector<HTMLDialogElement>('[data-viewer]');
    const root = box?.closest('.lb');
    if (box && root) initViewer(box, root);
  });

  function initViewer(box: HTMLDialogElement, root: Element) {
    const $ = <T extends Element>(sel: string) => box.querySelector<T>(sel)!;
    const stage = $<HTMLElement>('[data-v-stage]');
    const print = $<HTMLElement>('[data-v-print]');
    const paper = $<HTMLElement>('[data-v-paper]');
    const pic = $<HTMLElement>('[data-v-pic]');
    const cap = $<HTMLElement>('[data-v-cap]');
    const credit = $<HTMLElement>('[data-v-credit]');
    const actEl = $<HTMLElement>('[data-v-act]');
    const count = $<HTMLElement>('[data-v-count]');
    const say = $<HTMLElement>('[data-v-say]');
    const prev = $<HTMLButtonElement>('[data-v-prev]');
    const next = $<HTMLButtonElement>('[data-v-next]');
    const piece = $<HTMLAnchorElement>('[data-v-piece]');
    const img = document.createElement('img');
    img.decoding = 'async';
    img.alt = '';
    img.draggable = false;
    pic.append(img);

    let set: HTMLButtonElement[] = [];
    let at = 0;
    let opener: HTMLButtonElement | null = null;
    let token = 0;
    let closing = false;
    const easeOut = 'cubic-bezier(.2,.7,.2,1)';

    const sizesFor = (ar: number) => {
      const px = Math.min(window.innerWidth - 32, (window.innerHeight - 170) * ar);
      return `${Math.max(320, Math.round(px))}px`;
    };

    function show(i: number, dir: number) {
      at = (i + set.length) % set.length;
      const b = set[at];
      const d = b.dataset;
      const thumb = b.querySelector('img');
      const w = Number(d.w) || 3;
      const h = Number(d.h) || 4;
      const ar = w / h;
      print.style.setProperty('--ar', String(ar));
      paper.classList.toggle('has-credit', Boolean(d.credit));
      const cut = d.kind === 'cut' && Boolean(d.shadow);
      print.classList.toggle('is-cut', cut);
      print.classList.toggle('on-white', cut && d.ground === 'white');
      if (cut) {
        pic.style.setProperty('--overhang', d.overhang ?? '0');
        pic.style.setProperty('--shadow-img', `url(${d.shadow})`);
      } else {
        pic.style.removeProperty('--overhang');
        pic.style.removeProperty('--shadow-img');
      }

      // the small print is already loaded: show it at once, then swap in the large one
      const my = ++token;
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.width = w;
      img.height = h;
      img.alt = thumb?.alt ?? '';
      img.src = thumb?.currentSrc || d.src || '';
      if (d.full && d.src) {
        const big = new Image();
        big.decoding = 'async';
        big.sizes = sizesFor(ar);
        big.srcset = d.full;
        big.src = d.src;
        big.decode().then(() => {
          if (my !== token) return;
          img.sizes = big.sizes;
          img.srcset = d.full!;
          img.src = d.src!;
        }).catch(() => {});
      }

      cap.textContent = d.cap ?? '';
      cap.hidden = !d.cap;
      if (d.credit) {
        const role = document.createElement('b');
        role.textContent = copy.shotBy;
        credit.replaceChildren(role, ` ${d.credit}`);
      } else credit.replaceChildren();
      credit.hidden = !d.credit;
      actEl.textContent = d.act ?? '';
      count.textContent = `${at + 1} / ${set.length}`;
      say.textContent = copy.viewer.announce(at + 1, set.length, img.alt);
      if (d.href && d.piece) {
        piece.href = d.href;
        piece.textContent = d.piece;
        piece.hidden = false;
      } else {
        piece.hidden = true;
        piece.removeAttribute('href');
      }
      const many = set.length > 1;
      prev.hidden = !many;
      next.hidden = !many;

      if (dir && !reduceMotion()) {
        print.animate(
          [{ opacity: 0, transform: `translate3d(${dir * 40}px, 0, 0) rotate(${dir * 2}deg)` }, { opacity: 1, transform: 'none' }],
          { duration: 200, easing: easeOut },
        );
      }
    }

    const go = (dir: number) => { if (set.length > 1) show(at + dir, dir); };

    function open(b: HTMLButtonElement) {
      const sheet = b.closest('[data-sheet]');
      set = sheet ? [...sheet.querySelectorAll<HTMLButtonElement>('[data-shot]')] : [b];
      opener = b;
      show(Math.max(0, set.indexOf(b)), 0);
      document.documentElement.classList.add('lb-lock');
      box.showModal();
      if (!reduceMotion()) {
        box.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease-out' });
        print.animate(
          [{ opacity: 0.3, transform: 'translate3d(0, 28px, 0) scale(.92) rotate(-3deg)' }, { opacity: 1, transform: 'none' }],
          { duration: 220, easing: easeOut },
        );
        requestAnimationFrame(() => flash(print));
      }
    }

    function close() {
      if (!box.open || closing) return;
      if (reduceMotion()) { box.close(); return; }
      closing = true;
      box.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-out' }).finished
        .catch(() => {})
        .then(() => { closing = false; if (box.open) box.close(); });
    }

    box.addEventListener('close', () => {
      token++;
      document.documentElement.classList.remove('lb-lock');
      opener?.focus({ preventScroll: true });
    });
    box.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    $<HTMLButtonElement>('[data-v-close]').addEventListener('click', close);
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });

    // a swipe sideways moves through the act; a tap on the bare table closes
    let sx = 0;
    let sy = 0;
    let down = false;
    let swiped = false;
    stage.addEventListener('pointerdown', (e) => {
      if (!e.isPrimary) return;
      sx = e.clientX;
      sy = e.clientY;
      down = true;
      swiped = false;
    });
    stage.addEventListener('pointerup', (e) => {
      if (!down) return;
      down = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.3) {
        swiped = true;
        go(dx < 0 ? 1 : -1);
      }
    });
    stage.addEventListener('pointercancel', () => { down = false; });
    stage.addEventListener('click', (e) => {
      if (swiped) { swiped = false; return; }
      if (e.target === stage) close();
    });

    root.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-shot]');
      if (b && root.contains(b)) open(b);
    });
  }
</script>

<style>
  .lb-box {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(circle, rgb(255 46 110 / .16) 1.15px, transparent 1.7px) 0 0 / 7px 7px,
      radial-gradient(circle, rgb(255 46 110 / .16) 1.15px, transparent 1.7px) 3.5px 3.5px / 7px 7px,
      var(--ink);
    color: var(--white);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lb-box[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .lb-box::backdrop { background: rgb(11 11 11 / .6); }
  :global(html.lb-lock) { overflow: hidden; }

  .lb-box-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    /* the close button sits at least 16px inside the top and right edges, its focus ring too (D7) */
    padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) 0 max(var(--pad), env(safe-area-inset-left, 0px));
  }
  .lb-box-title { min-width: 0; color: var(--yellow); font: 400 30px/1 var(--gothic); letter-spacing: .02em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-box-count { margin-left: 6px; color: var(--white); font: 800 12px/1 var(--sans); letter-spacing: .12em; vertical-align: 4px; }
  .lb-box-btn { display: grid; place-items: center; flex: none; width: 52px; height: 52px; border-radius: 50%; color: var(--white); transition: scale var(--fast) ease-out, color var(--fast) ease-out; }
  .lb-box-btn svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lb-box-btn:active { scale: .92; }
  .lb-box-btn[hidden] { display: grid !important; visibility: hidden; }

  /* the stage: the print fits the room left, whatever the photo's shape */
  .lb-box-stage { container-type: size; display: grid; place-items: center; padding: 30px 0 10px; touch-action: pan-y pinch-zoom; user-select: none; -webkit-user-select: none; }
  .lb-box-print {
    position: relative;
    width: min(100cqw - 2 * var(--pad), (100cqh - 46px) * var(--ar, .75) + 28px);
    margin: 0;
    rotate: -1.2deg;
  }
  .lb-box-print .ph-sh { background: rgb(0 0 0 / .7); box-shadow: 0 0 8px 3px rgb(0 0 0 / .7); }
  .lb-box-paper { position: relative; display: block; padding: 8px; background: var(--white); }
  .lb-box-paper.has-credit { padding-left: 24px; }
  .lb-box-pic { position: relative; display: block; }
  .lb-box-pic :global(img) { position: relative; width: 100%; height: auto; -webkit-touch-callout: none; }
  .lb-box-cutsh { display: none; }

  /* a cut-out: the yellow ground for paper, the piece tilted on it, its own silhouette for shadow */
  .lb-box-print.is-cut { width: min(100cqw - 2 * var(--pad), (100cqh - 40px) / (.21 + .76 / var(--ar, .8))); rotate: none; }
  .is-cut .lb-box-paper { padding: 10% 12% 11%; background: var(--yellow); }
  .is-cut.on-white .lb-box-paper { background: var(--white); }
  .is-cut .lb-box-pic { rotate: -2deg; }
  .is-cut .lb-box-cutsh { display: block; position: absolute; inset: var(--overhang, 0); background: var(--shadow-img) center / 100% 100% no-repeat; translate: 13px 15px; }
  .lb-box-credit { position: absolute; left: 6px; bottom: 10px; writing-mode: vertical-rl; rotate: 180deg; color: var(--ink); font: 600 10px/1 var(--sans); letter-spacing: .06em; white-space: nowrap; }
  .lb-box-credit :global(b) { font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  /* the script caption on its black tape, stuck across the print's top corner, as on the sheet */
  .lb-box-cap {
    position: absolute;
    z-index: 2;
    left: -18px;
    top: -24px;
    max-width: calc(100% + 18px);
    padding: 2px 18px 8px 14px;
    background: var(--ink);
    color: var(--pink);
    font: 400 clamp(30px, 6vw, 46px)/1 var(--script);
    rotate: -5deg;
    clip-path: polygon(0 8%, 4% 0, 30% 5%, 62% 0, 96% 4%, 100% 0, 98% 52%, 100% 100%, 70% 95%, 38% 100%, 3% 94%, 0 100%, 2% 50%);
    pointer-events: none;
  }

  .lb-box-nav {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 52px;
    align-items: center;
    gap: 10px;
    padding: 4px max(8px, env(safe-area-inset-right, 0px)) max(10px, env(safe-area-inset-bottom, 0px)) max(8px, env(safe-area-inset-left, 0px));
  }
  .lb-box-piece {
    position: relative;
    isolation: isolate;
    grid-column: 2;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 4px 18px 0;
    color: var(--ink);
    font: 400 24px/1 var(--gothic);
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .lb-box-piece::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--yellow);
    rotate: -2deg;
    clip-path: polygon(0 4%, 6% 0, 50% 6%, 94% 0, 100% 8%, 98% 50%, 100% 94%, 92% 100%, 48% 95%, 5% 100%, 0 92%, 2% 50%);
  }
  .lb-box-next { grid-column: 3; }

  @media (min-width: 1000px) {
    .lb-box-stage { padding: 40px 88px 16px; }
    .lb-box-nav { position: static; }
    .lb-box-prev, .lb-box-next { position: fixed; top: 50%; translate: 0 -50%; width: 64px; height: 64px; }
    .lb-box-prev { left: max(16px, 1.6vw); }
    .lb-box-next { right: max(16px, 1.6vw); }
    .lb-box-btn svg { width: 30px; height: 30px; }
    .lb-box-title { font-size: 36px; }
  }
  @media (hover: hover) {
    .lb-box-btn:hover { color: var(--yellow); scale: 1.08; }
    .lb-box-piece:hover { text-decoration: underline 2px; text-underline-offset: .2em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-box-btn:hover, .lb-box-btn:active { scale: none; }
  }
</style>
