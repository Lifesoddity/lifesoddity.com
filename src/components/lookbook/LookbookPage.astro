---
// THE LOOKBOOK: the magazine's paparazzi spread. The title card, then one spread per act (the
// newest first), each a busy contact sheet of his photos; a tap opens a photo large in place.
// Everything comes from the content files and Shopify: a new act, a new product photo or a new
// credit in acts.ts lands here with no change to this page.
import PageHead from '../ui/PageHead.astro';
import ActSpread from './ActSpread.astro';
import Viewer from './Viewer.astro';
import { getSpreads } from './spreads';
import { lookbook as copy } from '../../content/copy/lookbook';
import { site } from '../../content/site';

const spreads = await getSpreads();

// search engines: the photos as one gallery, with the credit wherever his captions name one
const abs = (src: string) => (/^https?:/.test(src) ? src : new URL(src, site.url).href);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: copy.galleryName,
  url: `${site.url}/lookbook/`,
  image: spreads.flatMap((s) =>
    s.shots.map((shot) => ({
      '@type': 'ImageObject',
      contentUrl: abs(shot.full.src),
      description: shot.alt,
      ...(shot.credit ? { creditText: shot.credit } : {}),
    })),
  ),
};
---

<div class="lb">
  <PageHead title={copy.title} script={copy.script} deck={copy.deck} tone="yellow">
    {spreads.length > 1 && (
      <nav class="lb-jump" aria-label={copy.jumpLabel}>
        {spreads.map((s) => <a href={`#${s.act.slug}`}><span>{s.act.title}</span></a>)}
      </nav>
    )}
  </PageHead>

  {spreads.map((s, i) => <ActSpread spread={s} first={i === 0} />)}

  <Viewer />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld).replace(/</g, '\\u003c')}></script>
</div>

<script>
  // The prints are dealt onto the table the first time a sheet comes into view: each drops
  // from a steeper tilt into its own, one after another, and the first one flashes. The
  // prints are visible by default; this only runs when motion is welcome.
  import { flash, reduceMotion } from '../../scripts/motion';

  const sheets = document.querySelectorAll<HTMLElement>('.lb [data-sheet]');
  if (sheets.length && !reduceMotion() && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        io.unobserve(en.target);
        const shots = [...en.target.querySelectorAll<HTMLElement>('.lb-shot')];
        shots.forEach((el, i) => {
          const lean = Number(el.dataset.tilt ?? 0) < 0 ? -7 : 7;
          el.animate(
            [
              { opacity: 0, transform: `translate3d(0, 34px, 0) rotate(${lean}deg) scale(1.07)` },
              { opacity: 1, transform: 'none' },
            ],
            { duration: 240, delay: i * 60, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' },
          );
        });
        const lead = en.target.querySelector('.lb-print');
        window.setTimeout(() => flash(lead), 240);
      }
    }, { rootMargin: '0px 0px -10% 0px' });
    sheets.forEach((s) => io.observe(s));
  }
</script>

<style>
  .lb-jump { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 2px; }
  .lb-jump a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 2px 18px 8px 14px;
    color: var(--pink);
    font: 400 30px/1 var(--script);
    text-decoration: none;
    rotate: -3deg;
  }
  .lb-jump a:nth-child(even) { rotate: 2deg; }
  .lb-jump a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    clip-path: polygon(0 8%, 4% 0, 30% 5%, 62% 0, 96% 4%, 100% 0, 98% 52%, 100% 100%, 70% 95%, 38% 100%, 3% 94%, 0 100%, 2% 50%);
  }
  .lb-jump a span { position: relative; top: 2px; }
  @media (min-width: 1000px) {
    .lb-jump { position: absolute; right: var(--pad); bottom: 3vw; justify-content: flex-end; max-width: 46%; }
    .lb-jump a { font-size: 36px; }
  }
  @media (hover: hover) {
    .lb-jump a { transition: scale var(--fast) ease-out; }
    .lb-jump a:hover { scale: 1.06; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-jump a:hover { scale: none; }
  }
</style>
