---
// The title card of the profile: LIFE IS ODD in giant type on the cover's pink, credited to
// where he wrote it. Beside it, where a profile prints its subject's portrait, a black print
// with no photo on it yet: WHO IS HE?, flash-lit, and an UNCONFIRMED sticker saying his story
// is not on the record yet. Nothing about him is guessed, and nothing is promised.
import { acts } from '../../content/acts';
import { site } from '../../content/site';
import { about } from '../../content/copy/about';
import { pending } from '../../content/copy/common';

/** Two lines, the last word alone: "Life Is" / "Odd". */
const splitLast = (s: string) => {
  const i = s.lastIndexOf(' ');
  return i > 0 ? [s.slice(0, i), s.slice(i + 1)] : [s];
};
const title = splitLast(site.tagline);
const who = splitLast(about.who.print);
const dated = [...acts].sort((a, b) => Date.parse(a.opened) - Date.parse(b.opened));
const span = dated.length ? about.issueSpan(dated[0].title, dated[dated.length - 1].title) : null;
const issue = [about.issueLead, span, site.bio].filter(Boolean).join(' · ');
---

<section class="pf halftone" aria-labelledby="pf-title">
  <div class="pf-head">
    <h1 class="pf-title" id="pf-title">
      {title.map((l, i) => (
        <>{i > 0 && ' '}<span class="pf-line">{l}{i === title.length - 1 && <span class="pf-script" aria-hidden="true">{about.script}</span>}</span></>
      ))}
    </h1>
    <p class="pf-credit">{about.titleCredit}</p>
  </div>

  <div class="pf-who">
    <figure class="pf-print ph print" data-flash data-flash-first aria-label={about.who.label}>
      <span class="ph-sh" aria-hidden="true"></span>
      <div class="pf-dark halftone">
        <svg class="pf-cam" viewBox="0 0 48 48" aria-hidden="true"><path d="M7 16.5h8l3.5-5.5h11l3.5 5.5h8v20H7z"></path><circle cx="24" cy="26" r="6.5"></circle><path d="M6.5 41.5 41.5 6.5"></path></svg>
        <p class="pf-q">{who.map((l) => <span>{l}</span>)}</p>
      </div>
      <span class="ph-flash" aria-hidden="true"></span>
    </figure>
    <p class="tape pf-tape" aria-hidden="true">{about.who.tape}</p>
    <p class="pf-pending sticker"><span class="stamp">{pending.stamp}</span> <span>{about.who.line}</span></p>
  </div>

  <p class="pf-issue">{issue}</p>
</section>

<style>
  .pf {
    --dot: rgb(81 42 52 / .34);
    --fade: radial-gradient(95% 55% at 0% 100%, #000 5%, transparent 72%), radial-gradient(70% 45% at 100% 0%, #000, transparent 70%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "head" "who" "issue";
    row-gap: 22px;
    padding: 20px var(--pad) 22px;
    background: var(--cover);
    overflow: clip;
  }
  .pf > * { position: relative; z-index: 1; }

  .pf-head { grid-area: head; position: relative; display: grid; gap: 14px; }
  .pf-title { color: var(--white); font: 400 min(47vw, 360px)/.8 var(--gothic); letter-spacing: .005em; text-transform: uppercase; }
  .pf-line { position: relative; display: block; width: max-content; }
  /* the script overlay hangs off the end of the last line, over the pink, not over the letters */
  .pf-script { position: absolute; left: 92%; top: 20%; color: var(--white); font: 400 clamp(44px, 12vw, 110px)/1 var(--script); letter-spacing: 0; text-transform: none; rotate: -8deg; white-space: nowrap; pointer-events: none; }
  .pf-credit { max-width: 32ch; font: 700 14.5px/1.38 var(--sans); }

  /* where the portrait goes: a black print, no photo yet. On a phone it takes the right half,
     with the UNCONFIRMED sticker beside it, so his own lines start inside the second screen */
  .pf-who { grid-area: who; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; column-gap: 12px; justify-items: center; padding-top: 14px; }
  .pf-print { grid-column: 2; grid-row: 1; width: 100%; padding: 7px; background: var(--white); rotate: 3deg; }
  .pf-dark {
    --dot: rgb(255 46 110 / .26);
    --fade: radial-gradient(80% 70% at 50% 40%, #000, transparent 80%);
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6%;
    aspect-ratio: 4 / 5;
    background: var(--ink);
    color: var(--yellow);
    container-type: inline-size;
  }
  .pf-cam { width: 22cqi; height: 22cqi; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pf-q { font: 400 34cqi/.84 var(--gothic); text-align: center; text-transform: uppercase; }
  .pf-q span { display: block; }
  /* the tape tags the print's top-left corner, wherever the print sits */
  .pf-tape { left: 44%; top: 2px; font-size: 24px; rotate: -6deg; }
  .pf-pending { grid-column: 1; grid-row: 1; position: relative; z-index: 3; justify-self: start; display: grid; gap: 8px; justify-items: start; max-width: none; margin-top: 0; padding: 12px 14px 13px; background: var(--white); font: 700 14px/1.38 var(--sans); box-shadow: 0 8px 14px rgb(60 0 18 / .35); }

  .pf-issue { grid-area: issue; padding: 6px 0 5px; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--ink); font: 800 10.5px/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; }

  @media (min-width: 700px) {
    .pf { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-areas: "head who" "issue issue"; column-gap: 28px; padding-top: 30px; }
    .pf-head { align-self: start; }
    .pf-title { font-size: min(25vw, 360px); }
    .pf-script { left: 96%; top: 30%; font-size: 5.4vw; }
    .pf-credit { font-size: 16px; }
    /* one column again: the print, then the sticker overlapping its foot */
    .pf-who { grid-template-columns: minmax(0, 1fr); align-items: normal; column-gap: 0; align-self: start; padding-top: 6px; }
    .pf-print { grid-column: auto; grid-row: auto; width: 86%; }
    .pf-tape { left: 4%; font-size: 32px; }
    .pf-pending { grid-column: auto; grid-row: auto; justify-self: start; max-width: 300px; margin: -22px 0 0 -8%; }
    .pf-issue { margin-top: 8px; font-size: 11px; }
  }

  @media (min-width: 1000px) {
    .pf { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: 4vw; padding: 3vw var(--pad) 2.4vw; }
    .pf-head { gap: 1.6vw; }
    .pf-script { font-size: min(6.6vw, 100px); }
    .pf-credit { max-width: 30ch; font-size: max(16px, 1.25vw); }
    .pf-print { width: min(74%, 470px); margin-top: 1vw; }
    .pf-tape { left: 8%; font-size: min(3vw, 44px); }
    .pf-pending { justify-self: end; max-width: 330px; margin: -5vw 2% 0 0; font-size: 15px; }
    .pf-script { top: 24%; }
    .pf-issue { font-size: 12px; }
  }
</style>
