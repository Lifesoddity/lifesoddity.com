---
// The bag: a drawer from the right (a native dialog: focus stays inside, Escape closes it).
// It lists what is in the bag, lets the visitor change quantities, and sends them to Shopify's
// checkout in the same tab.
import { bag } from '../../content/copy/common';
import { site } from '../../content/site';
---

<dialog class="drawer" aria-labelledby="drawer-title" data-domain={site.checkoutDomain}>
  <div class="drawer-in halftone">
    <div class="drawer-head">
      <h2 class="drawer-title" id="drawer-title">{bag.title}</h2>
      <button class="drawer-close" type="button" data-close-bag aria-label={bag.close}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16"></path></svg>
      </button>
    </div>

    <ul class="drawer-list" data-list></ul>

    <div class="drawer-empty" data-empty>
      <p>{bag.empty}</p>
      <a class="drawer-empty-link" href="/shop/">{bag.emptyLink}</a>
    </div>

    <div class="drawer-foot" data-foot hidden>
      <p class="drawer-sub"><span>{bag.subtotal}</span> <b class="num" data-subtotal></b></p>
      <p class="drawer-ship">{bag.shipping}</p>
      <a class="addbag drawer-checkout" href="#" data-checkout><span>{bag.checkout}</span></a>
      <p class="drawer-note">{bag.checkoutNote}</p>
    </div>
    <p class="vh" aria-live="polite" data-drawer-live></p>
  </div>

  <template data-row>
    <li class="drawer-item">
      <div class="drawer-meta">
        <a class="drawer-name"></a>
        <span class="drawer-size"></span>
        <span class="drawer-price num"></span>
      </div>
      <div class="drawer-qty" role="group">
        <button class="drawer-step" type="button" data-step="-1" aria-label={bag.less}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10h11"></path></svg></button>
        <span class="drawer-n num"></span>
        <button class="drawer-step" type="button" data-step="1" aria-label={bag.more}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10h11M10 4.5v11"></path></svg></button>
      </div>
      <button class="drawer-remove" type="button" data-remove>{bag.remove}</button>
    </li>
  </template>
</dialog>

<script>
  import { bagItems, checkoutUrl, setQty, type BagItem } from '../../scripts/bag';
  import { formatPrice } from '../../lib/money';
  import { bag } from '../../content/copy/common';
  import { reduceMotion } from '../../scripts/motion';

  const drawer = document.querySelector<HTMLDialogElement>('dialog.drawer');
  if (drawer) {
    const list = drawer.querySelector<HTMLUListElement>('[data-list]')!;
    const empty = drawer.querySelector<HTMLElement>('[data-empty]')!;
    const foot = drawer.querySelector<HTMLElement>('[data-foot]')!;
    const subtotal = drawer.querySelector<HTMLElement>('[data-subtotal]')!;
    const checkout = drawer.querySelector<HTMLAnchorElement>('[data-checkout]')!;
    const row = drawer.querySelector<HTMLTemplateElement>('template[data-row]')!;
    const live = drawer.querySelector<HTMLElement>('[data-drawer-live]')!;
    const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-close-bag]')!;
    const domain = drawer.dataset.domain!;
    /** One row per variant, kept across renders so a focused button is never destroyed. */
    const rows = new Map<number, HTMLLIElement>();

    const titleOf = (it: BagItem) => it.t || bag.missingItem;
    const current = (v: number) => bagItems().find((i) => i.v === v);

    /** One persistent polite region says what changed; cleared first so a repeat is heard. */
    const announce = (msg: string) => {
      live.textContent = '';
      requestAnimationFrame(() => { live.textContent = msg; });
    };

    /** Take a line out, then move focus to the next row's Remove, else the previous one's, else close. */
    const removeLine = (v: number) => {
      const it = current(v);
      if (!it) return;
      const order = bagItems().map((i) => i.v);
      const at = order.indexOf(v);
      setQty(v, 0);
      const nextV = order[at + 1] ?? order[at - 1];
      const target = nextV !== undefined ? rows.get(nextV)?.querySelector<HTMLButtonElement>('[data-remove]') : null;
      (target ?? closeBtn).focus();
      announce(bag.removed(titleOf(it)));
    };

    const makeRow = (v: number) => {
      const li = row.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      li.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
        b.addEventListener('click', () => {
          const it = current(v);
          if (!it) return;
          const n = Math.min(it.q + Number(b.dataset.step), 9);
          if (n <= 0) { removeLine(v); return; }
          setQty(v, n);
          announce(bag.qtyNow(n));
        }),
      );
      li.querySelector<HTMLButtonElement>('[data-remove]')!.addEventListener('click', () => removeLine(v));
      return li;
    };

    const fill = (li: HTMLLIElement, it: BagItem) => {
      const t = titleOf(it);
      let img = li.querySelector<HTMLImageElement>('.drawer-thumb');
      if (it.i && !img) {
        img = document.createElement('img');
        img.className = 'drawer-thumb';
        img.alt = '';
        img.width = 72;
        img.height = 72;
        img.loading = 'lazy';
        li.prepend(img);
      }
      if (img && !it.i) img.remove();
      else if (img && img.getAttribute('src') !== it.i) img.src = it.i;
      const name = li.querySelector<HTMLAnchorElement>('.drawer-name')!;
      name.textContent = t;
      if (it.h) name.href = `/products/${it.h}/`; else name.removeAttribute('href');
      li.querySelector('.drawer-size')!.textContent = it.s ? `${bag.size} ${it.s}` : '';
      li.querySelector('.drawer-price')!.textContent = it.p ? formatPrice(it.p * it.q) : '';
      li.querySelector('.drawer-n')!.textContent = String(it.q);
      li.querySelector('.drawer-qty')!.setAttribute('aria-label', `${t}, size ${it.s}`);
      const [less, more] = li.querySelectorAll<HTMLButtonElement>('[data-step]');
      less.setAttribute('aria-label', bag.lessFor(t, it.s));
      more.setAttribute('aria-label', bag.moreFor(t, it.s));
      li.querySelector('[data-remove]')!.setAttribute('aria-label', bag.removeFor(t, it.s));
    };

    const render = () => {
      const items = bagItems();
      const want: HTMLLIElement[] = [];
      for (const it of items) {
        let li = rows.get(it.v);
        if (!li) { li = makeRow(it.v); rows.set(it.v, li); }
        fill(li, it);
        want.push(li);
      }
      const keep = new Set(items.map((i) => i.v));
      for (const [v, li] of rows) if (!keep.has(v)) { li.remove(); rows.delete(v); }
      const have = [...list.children];
      if (have.length !== want.length || want.some((li, i) => have[i] !== li)) list.append(...want);
      const total = items.reduce((n, i) => n + i.p * i.q, 0);
      subtotal.textContent = formatPrice(total);
      empty.hidden = items.length > 0;
      foot.hidden = items.length === 0;
      checkout.href = items.length ? checkoutUrl(domain) : '#';
    };

    const open = () => { render(); if (!drawer.open) drawer.showModal(); };

    document.addEventListener('lo:bag', render);
    document.addEventListener('lo:bag-render', render);
    document.addEventListener('lo:open-bag', open);
    document.querySelectorAll('[data-open-bag]').forEach((b) => b.addEventListener('click', open));
    // it leaves the way it came: back out to the right in 160 ms, then the dialog closes
    let closing = false;
    const shut = () => {
      if (!drawer.open || closing) return;
      if (reduceMotion()) { drawer.close(); return; }
      closing = true;
      drawer.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(100%)' }], { duration: 160, easing: 'cubic-bezier(.4, 0, 1, 1)' }).finished
        .catch(() => {})
        .then(() => { closing = false; if (drawer.open) drawer.close(); });
    };
    closeBtn.addEventListener('click', shut);
    drawer.addEventListener('click', (e) => { if (e.target === drawer) shut(); });
    drawer.addEventListener('cancel', (e) => { e.preventDefault(); shut(); });
    checkout.addEventListener('click', (e) => {
      e.preventDefault();
      if (!bagItems().length) return;
      location.assign(checkoutUrl(domain));
    });
    render();
  }
</script>

<style>
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(440px, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 4px solid var(--ink);
    background: var(--yellow);
    color: var(--ink);
    overscroll-behavior: contain;
  }
  .drawer[open] { animation: drawer-in 220ms var(--ease-out); }
  .drawer::backdrop { background: rgb(11 11 11 / .45); }
  @keyframes drawer-in { from { transform: translateX(100%); } }
  .drawer-in {
    --dot: rgb(11 11 11 / .1);
    --fade: radial-gradient(80% 50% at 100% 0%, #000, transparent 75%);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    height: 100%;
    padding: max(16px, env(safe-area-inset-top, 0px)) 20px calc(20px + env(safe-area-inset-bottom, 0px));
    overflow: auto;
  }
  .drawer-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 3px solid var(--ink); }
  .drawer-title { font: 400 48px/.9 var(--gothic); text-transform: uppercase; }
  .drawer-close { display: grid; place-items: center; width: 44px; height: 44px; }
  .drawer-close svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .drawer-list { display: grid; align-content: start; }
  .drawer-item { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; grid-template-areas: "thumb meta qty" "thumb remove remove"; column-gap: 12px; row-gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--ink); }
  .drawer-thumb { grid-area: thumb; width: 72px; height: 72px; object-fit: cover; border: 3px solid var(--white); box-shadow: 4px 5px 4px -1px rgb(11 11 11 / .35); }
  .drawer-meta { grid-area: meta; display: grid; gap: 3px; align-content: start; min-width: 0; }
  .drawer-name { font: 400 26px/.95 var(--gothic); text-transform: uppercase; text-decoration: none; }
  .drawer-name[href]:hover { text-decoration: underline; }
  .drawer-size, .drawer-price { font: 700 13px/1.2 var(--sans); }
  .drawer-qty { grid-area: qty; display: flex; align-items: center; gap: 8px; }
  .drawer-step { display: grid; place-items: center; width: 44px; height: 44px; border: 2px solid var(--ink); background: var(--white); }
  .drawer-step svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .drawer-n { min-width: 1.5ch; text-align: center; font: 800 15px/1 var(--sans); }
  .drawer-remove { grid-area: remove; justify-self: start; padding: 6px 0; font: 700 12px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; text-decoration: underline; text-underline-offset: .25em; }
  .drawer-empty { display: grid; gap: 14px; align-content: start; padding-top: 22px; font: 700 17px/1.35 var(--sans); }
  .drawer-empty-link { font: 400 34px/1 var(--gothic); text-transform: uppercase; }
  .drawer-foot { display: grid; gap: 10px; padding-top: 16px; border-top: 3px solid var(--ink); }
  .drawer-sub { display: flex; justify-content: space-between; align-items: baseline; font: 800 13px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .drawer-sub b { font: 400 40px/.85 var(--gothic); letter-spacing: 0; }
  .drawer-ship, .drawer-note { font: 600 13px/1.4 var(--sans); }
  .drawer-checkout { display: grid; place-items: center; text-decoration: none; }
  @media (hover: hover) {
    .drawer-step:hover { background: var(--ink); color: var(--yellow); }
    .drawer-close svg { transition: rotate var(--fast) ease-out; }
    .drawer-close:hover svg { rotate: 90deg; }
    .drawer-remove:hover { text-decoration-color: var(--red); }
  }
  @media (prefers-reduced-motion: reduce) { .drawer[open] { animation: none; } }
</style>
