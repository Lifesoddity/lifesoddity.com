---
import { Image } from 'astro:assets';
import { brand } from '../../assets';
import { site, social, contact, nav } from '../../content/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <Image class="foot-logo" src={brand.logo} alt={site.name} width={264} height={99} />
  <p class="foot-line">{site.line}</p>
  <ul class="foot-links">
    {social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
    <li><a href={contact.href} rel="noopener">{contact.label}</a></li>
  </ul>
  <p class="foot-legal">
    © {year} {site.name}. {nav.map((n, i) => <>{i > 0 && ' '}<a href={n.href}>{n.label}</a></>)}
  </p>
</footer>
