---
// Every page: the head (title, description, link previews, structured data, fonts), the skip
// link, the masthead, the page, the footer and the bag. Pages pass their own title and image.
import { Font } from 'astro:assets';
import '../../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CartDrawer from './CartDrawer.astro';
import { site } from '../../content/site';
import { header } from '../../content/copy/common';
import { launchCheck } from '../../lib/launch';

interface Props {
  /** The page's own name, e.g. "She Devil Tee [Black]". The home page passes its full title. */
  title: string;
  description?: string;
  /** Absolute URL of a 1200x630 preview image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product';
  /** Structured data objects, written as JSON-LD. */
  ld?: object[];
  /** Product price for link previews. */
  price?: { amount: string; currency: string };
  noindex?: boolean;
  /** The whole title, without " | Life's Oddity" appended (the home page). */
  bare?: boolean;
}

const { title, description = site.description, image, imageAlt, type = 'website', ld = [], price, noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = bare ? title : `${title} | ${site.name}`;
const previewImage = image ?? new URL('/og.jpg', Astro.site).href;
// the default preview card is the logo over the tagline
const previewAlt = imageAlt ?? (image ? undefined : `${site.name}: ${site.tagline}`);
/** JSON-LD inside a script tag: a "<" typed into a Shopify title cannot close the tag. */
const jsonLd = (obj: object) => JSON.stringify(obj).replace(/</g, '\\u003c');
// once per build: lists in the log what the site still waits on (src/lib/launch.ts)
await launchCheck();
---

<!doctype html>
<html lang="en" data-store={site.checkoutDomain}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
    <meta name="theme-color" content="#FFE500" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {previewAlt && <meta property="og:image:alt" content={previewAlt} />}
    {price && <meta property="og:price:amount" content={price.amount} />}
    {price && <meta property="og:price:currency" content={price.currency} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-gothic" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-script" />

    {ld.map((obj) => <script type="application/ld+json" set:html={jsonLd(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#page">{header.skip}</a>
    <Header />
    <main id="page" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <p class="vh" aria-live="polite" data-announce></p>
    <CartDrawer />
    <script>
      import { initBag } from '../../scripts/bag';
      import { initBuy } from '../../scripts/buy';
      import { initLive } from '../../scripts/live';
      import { bindFlash } from '../../scripts/motion';
      import { initStory } from '../../scripts/story';
      import { initPlayers } from '../../scripts/player';
      import { initWaitlists } from '../../scripts/waitlist';

      const domain = document.documentElement.dataset.store || 'lifesoddity.myshopify.com';
      // each one on its own: one failure cannot stop the others
      const run = (name: string, init: () => void) => {
        try { init(); } catch (err) { console.error(`[${name}]`, err); }
      };
      run('bag', () => initBag());
      run('buy', () => initBuy());
      run('live', () => initLive(domain));
      run('flash', () => bindFlash());
      run('story', () => initStory());
      run('players', () => initPlayers());
      run('waitlists', () => initWaitlists());
    </script>
  </body>
</html>
