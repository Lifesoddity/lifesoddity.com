---
// WHO'S NEXT? The next drop has no name or date yet, so no countdown: the next issue's cover,
// printed blank as on /drop (the logo for a masthead, a silhouette for a cover star, UNCONFIRMED
// stamped across it), and the waitlist. While no playlist link is in, the cover's last
// coverline jumps here (#whos-next).
import { Image } from 'astro:assets';
import WaitlistForm from '../ui/WaitlistForm.astro';
import { brand, cutouts } from '../../assets';
import { nextDrop } from '../../content/acts';
import { site } from '../../content/site';
import { home } from '../../content/copy/home';
import { pending } from '../../content/copy/common';

const n = home.next;
const name = nextDrop.name?.trim() || null;
const when = nextDrop.opensLabel?.trim() || null;
const deck = name ? `Next drop: ${name}${when ? `, ${when}` : ''}. Be the first to know.` : n.deck;
const coverLine = [name ? n.coverNamed(name) : n.coverIssue, when ?? n.coverDate, site.tagline].join(' · ');
const stamped = !name || !when;
---

<section class="next halftone" id="whos-next" aria-labelledby="next-title">
  <div class="wn-cover" aria-hidden="true">
    <span class="wn-sh"></span>
    <div class="wn-sheet halftone">
      <Image class="wn-logo" src={brand.logo} alt="" widths={[240, 480]} sizes="(min-width: 1000px) 24vw, (min-width: 700px) 32vw, 54vw" />
      <p class="wn-line">{coverLine}</p>
      <div class="wn-fig" style={`--bust:url(${cutouts.bustShadow.src})`}>
        <span class="wn-fig-sh"></span>
        <svg viewBox="0 0 300 340"><path d="M150 30c42 0 64 34 64 78 0 38-16 62-32 74l2 22c42 10 78 28 92 58 12 26 16 56 18 78H6c2-22 6-52 18-78 14-30 50-48 92-58l2-22c-16-12-32-36-32-74 0-44 22-78 64-78z"></path></svg>
      </div>
      <span class="wn-q">?</span>
      {stamped && <span class="stamp wn-stamp">{pending.stamp}</span>}
    </div>
  </div>
  <div class="next-copy">
    <h2 class="next-title" id="next-title">{n.title}</h2>
    <p class="next-deck">{deck}</p>
    <WaitlistForm act={name ? name.toLowerCase().replace(/\s+/g, '-') : 'next-drop'} />
  </div>
</section>

<style>
  .next {
    --dot: rgb(11 11 11 / .1);
    --fade: linear-gradient(#000, #000);
    display: grid;
    gap: 30px;
    padding: 48px var(--pad) 56px;
    background: var(--yellow);
    overflow: clip;
    scroll-margin-top: var(--header-h);
  }

  /* the next issue's cover, printed blank (the same print as /drop's, src/components/drop/NextIssue.astro) */
  .wn-cover { position: relative; justify-self: center; width: 72%; rotate: 3deg; }
  .wn-sh { position: absolute; inset: 0; background: var(--shadow); box-shadow: 0 0 5px 2px var(--shadow); translate: 12px 14px; }
  .wn-sheet {
    --dot: rgb(255 46 110 / .42);
    --fade: radial-gradient(75% 55% at 50% 40%, #000, transparent 72%);
    container-type: inline-size;
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: clip;
    border: 7px solid var(--white);
    background: var(--white);
    box-shadow: inset 0 0 0 1px rgb(11 11 11 / .12);
  }
  .wn-sheet :global(.wn-logo) { position: relative; z-index: 2; width: 74%; margin: 6% 0 0 5%; }
  /* the issue line prints over the cover star, as a masthead does: when it wraps, the ? passes under it */
  .wn-line {
    position: relative;
    z-index: 4;
    margin: 3% 5% 0;
    padding: 1.2% 0 1%;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font: 800 max(9.5px, 2.9cqw)/1.25 var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .wn-fig { position: absolute; z-index: 1; left: 12%; right: 12%; bottom: -2%; aspect-ratio: 300 / 340; }
  .wn-fig svg, .wn-fig-sh { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wn-fig svg { fill: var(--ink); }
  .wn-fig-sh { background: var(--bust) center / 100% 100% no-repeat; translate: 4% 3%; }
  .wn-q { position: absolute; z-index: 3; left: 50%; top: 24%; translate: -50% 0; rotate: 9deg; color: var(--pink); font: 400 84cqw/1 var(--script); pointer-events: none; }
  .wn-stamp {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 70%;
    translate: -50% 0;
    padding: .5em .6em .42em;
    border-width: 3px;
    background: var(--white);
    font-size: 9cqw;
    letter-spacing: .1em;
    white-space: nowrap;
    rotate: -11deg;
    box-shadow: inset 0 0 0 2px var(--white), inset 0 0 0 3.5px var(--red), 0 4px 8px rgb(11 11 11 / .25);
  }

  .next-copy { position: relative; display: grid; gap: 14px; align-content: start; }
  .next-title { font: 400 clamp(100px, 29vw, 230px)/.8 var(--gothic); text-transform: uppercase; }
  .next-deck { max-width: 26ch; font: 700 18px/1.35 var(--sans); }
  /* the yellow You're on the list. sticker would vanish on this ground: pink here, as on /drop */
  .next :global(.tip-ok) { background: var(--pink); }
  @media (min-width: 700px) {
    .next { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; column-gap: 36px; }
    .wn-cover { width: 100%; max-width: 460px; }
    .next-title { font-size: 15vw; }
  }
  @media (min-width: 1000px) {
    .next { padding: 5vw var(--pad); grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); column-gap: 5vw; }
    .next-title { font-size: 11vw; }
  }
</style>
